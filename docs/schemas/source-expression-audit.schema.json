{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zelda Suite source-table expression audit report",
  "description": "Source-only inventory of unresolved expressions from registered scalar data-table exports. Expressions are classified by syntax shape and are never evaluated.",
  "type": "object",
  "required": ["format", "format_version", "registry", "assets", "unresolved_expressions", "summary", "evidence"],
  "properties": {
    "format": {"const": "zelda-suite-source-expression-audit"},
    "format_version": {"const": 1},
    "registry": {"type": "string", "minLength": 1},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "unresolved_expressions": {"type": "array", "items": {"$ref": "#/$defs/expression"}},
    "summary": {"$ref": "#/$defs/summary"},
    "evidence": {
      "type": "object",
      "required": ["source_only", "rom_bytes_read", "assembler_expressions_evaluated"],
      "properties": {
        "source_only": {"const": true},
        "rom_bytes_read": {"const": false},
        "assembler_expressions_evaluated": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["asset_name", "source_file", "source_revision", "table_label", "directive", "entry_count", "direct_numeric_entry_count", "signed_decimal_entry_count", "unresolved_expression_count"],
      "properties": {
        "asset_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "source_file": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "table_label": {"type": "string", "minLength": 1},
        "directive": {"enum": ["db", "dw", "dl"]},
        "entry_count": {"type": "integer", "minimum": 1},
        "direct_numeric_entry_count": {"type": "integer", "minimum": 0},
        "signed_decimal_entry_count": {"type": "integer", "minimum": 0},
        "unresolved_expression_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "expression": {
      "type": "object",
      "required": ["asset_name", "source_file", "source_revision", "table_label", "directive", "table_index", "entry_file_offset", "source_line", "source_label", "expression", "classification", "reason"],
      "properties": {
        "asset_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "source_file": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "table_label": {"type": "string", "minLength": 1},
        "directive": {"enum": ["db", "dw", "dl"]},
        "table_index": {"type": "integer", "minimum": 0},
        "entry_file_offset": {"type": "integer", "minimum": 0},
        "source_line": {"type": "integer", "minimum": 1},
        "source_label": {"type": ["string", "null"]},
        "expression": {"type": "string", "minLength": 1},
        "classification": {"enum": ["symbol", "symbol_with_numeric_addend", "compound_or_assembler_specific", "other"]},
        "reason": {"const": "Expression is not a supported numeric literal; it was not evaluated."}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["table_asset_count", "entry_count", "direct_numeric_entry_count", "signed_decimal_entry_count", "unresolved_expression_count", "classification_counts"],
      "properties": {
        "table_asset_count": {"type": "integer", "minimum": 1},
        "entry_count": {"type": "integer", "minimum": 1},
        "direct_numeric_entry_count": {"type": "integer", "minimum": 0},
        "signed_decimal_entry_count": {"type": "integer", "minimum": 0},
        "unresolved_expression_count": {"type": "integer", "minimum": 0},
        "classification_counts": {
          "type": "object",
          "required": ["symbol", "symbol_with_numeric_addend", "compound_or_assembler_specific", "other"],
          "properties": {
            "symbol": {"type": "integer", "minimum": 0},
            "symbol_with_numeric_addend": {"type": "integer", "minimum": 0},
            "compound_or_assembler_specific": {"type": "integer", "minimum": 0},
            "other": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
