{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zelda Suite extracted asset registry",
  "description": "Named catalog of source-derived JSON assets with format and provenance expectations.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "assets"
  ],
  "properties": {
    "format": {
      "const": "zelda-suite-asset-registry"
    },
    "format_version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "name",
        "file",
        "format",
        "source_revision",
        "record_count",
        "subsystem",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        },
        "format": {
          "enum": [
            "zelda-suite-pointer-table",
            "zelda-suite-incbin-inventory",
            "zelda-suite-data-table",
            "zelda-suite-dictionary-inventory",
            "zelda-suite-text-message-index",
          "zelda-suite-sprite-dispatch"
          ]
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "subsystem": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
