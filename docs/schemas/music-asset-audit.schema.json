{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zelda Suite music asset cross-reference audit",
  "description": "Source-only join between registered symbolic music pointers and incbin payload declarations. Audio payload bytes, ROM bytes, pointer values, and offsets are not verified.",
  "type": "object",
  "required": [
    "format", "format_version", "registry", "index_asset_name", "payload_asset_name",
    "source_file", "source_revision", "cross_references", "missing_payload_targets",
    "unreferenced_payload_labels", "payloads_missing_size", "findings", "summary", "evidence"
  ],
  "properties": {
    "format": {"const": "zelda-suite-music-asset-audit"},
    "format_version": {"const": 1},
    "registry": {"type": "string", "minLength": 1},
    "index_asset_name": {"type": "string", "minLength": 1},
    "payload_asset_name": {"type": "string", "minLength": 1},
    "source_file": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "cross_references": {"type": "array", "items": {"$ref": "#/$defs/cross_reference"}},
    "missing_payload_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unreferenced_payload_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "payloads_missing_size": {"type": "array", "items": {"$ref": "#/$defs/missing_size"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "summary": {"$ref": "#/$defs/summary"},
    "evidence": {
      "type": "object",
      "required": [
        "source_only", "rom_bytes_read", "audio_payload_bytes_read",
        "pointer_values_resolved", "offsets_verified"
      ],
      "properties": {
        "source_only": {"const": true},
        "rom_bytes_read": {"const": false},
        "audio_payload_bytes_read": {"const": false},
        "pointer_values_resolved": {"const": false},
        "offsets_verified": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cross_reference": {
      "type": "object",
      "required": [
        "table_index", "track_index", "pointer_entry_file_offset", "pointer_expression",
        "target_label", "is_empty", "alias_of_track_index", "payload_declaration_found",
        "payload_label", "incbin_path", "declared_size_bytes", "source_file_offset_start",
        "source_file_offset_end", "source_range_size_matches"
      ],
      "properties": {
        "table_index": {"type": "integer", "minimum": 0},
        "track_index": {"type": "integer", "minimum": 0},
        "pointer_entry_file_offset": {"type": "integer", "minimum": 0},
        "pointer_expression": {"type": "string", "minLength": 1},
        "target_label": {"type": ["string", "null"]},
        "is_empty": {"type": "boolean"},
        "alias_of_track_index": {"type": ["integer", "null"], "minimum": 0},
        "payload_declaration_found": {"type": ["boolean", "null"]},
        "payload_label": {"type": ["string", "null"]},
        "incbin_path": {"type": ["string", "null"]},
        "declared_size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "source_file_offset_start": {"type": ["integer", "null"], "minimum": 0},
        "source_file_offset_end": {"type": ["integer", "null"], "minimum": 0},
        "source_range_size_matches": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "missing_size": {
      "type": "object",
      "required": ["label", "incbin_path", "source_file_offset_start", "source_file_offset_end"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "incbin_path": {"type": "string", "minLength": 1},
        "source_file_offset_start": {"type": ["integer", "null"], "minimum": 0},
        "source_file_offset_end": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["code", "severity", "message", "track_index", "target_label", "payload_label", "incbin_path"],
      "properties": {
        "code": {
          "enum": [
            "source_provenance_mismatch", "duplicate_payload_label",
            "missing_payload_declaration", "unreferenced_payload_declaration",
            "payload_size_missing", "payload_source_range_mismatch"
          ]
        },
        "severity": {"enum": ["error", "warning"]},
        "message": {"type": "string", "minLength": 1},
        "track_index": {"type": ["integer", "null"], "minimum": 0},
        "target_label": {"type": ["string", "null"]},
        "payload_label": {"type": ["string", "null"]},
        "incbin_path": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "track_entry_count", "empty_pointer_count", "nonempty_pointer_count",
        "alias_entry_count", "unique_target_label_count", "payload_declaration_count",
        "matched_payload_label_count", "missing_payload_target_count",
        "missing_payload_reference_count", "unreferenced_payload_count",
        "payload_without_size_count", "payload_source_range_mismatch_count",
        "duplicate_payload_label_count", "error_count", "warning_count", "finding_count"
      ],
      "properties": {
        "track_entry_count": {"type": "integer", "minimum": 0},
        "empty_pointer_count": {"type": "integer", "minimum": 0},
        "nonempty_pointer_count": {"type": "integer", "minimum": 0},
        "alias_entry_count": {"type": "integer", "minimum": 0},
        "unique_target_label_count": {"type": "integer", "minimum": 0},
        "payload_declaration_count": {"type": "integer", "minimum": 0},
        "matched_payload_label_count": {"type": "integer", "minimum": 0},
        "missing_payload_target_count": {"type": "integer", "minimum": 0},
        "missing_payload_reference_count": {"type": "integer", "minimum": 0},
        "unreferenced_payload_count": {"type": "integer", "minimum": 0},
        "payload_without_size_count": {"type": "integer", "minimum": 0},
        "payload_source_range_mismatch_count": {"type": "integer", "minimum": 0},
        "duplicate_payload_label_count": {"type": "integer", "minimum": 0},
        "error_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0},
        "finding_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
