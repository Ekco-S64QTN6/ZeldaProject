{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zelda Suite special-shop transaction source export",
  "description": "Source-only inventory of two Bomb Shop purchases and the Bottle Vendor bottle sale. The Super Bomb uses a state flag/tagalong reward rather than a receipt selector. Source range comments and runtime behavior are not ROM-verified.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "source_revision",
    "source_file",
    "entry_count",
    "entries",
    "evidence"
  ],
  "properties": {
    "format": {
      "const": "zelda-suite-special-shop-transactions"
    },
    "format_version": {
      "const": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "entry_count": {
      "const": 3
    },
    "entries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "source_file": {
      "type": "string",
      "minLength": 1,
      "description": "Sorted, semicolon-separated set of source files referenced by the entries."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "table_index",
        "transaction_label",
        "shop_type",
        "source_file",
        "source_handler_label",
        "source_handler_range_annotation",
        "source_handler_label_line",
        "reward_handler_label",
        "reward_handler_range_annotation",
        "reward_handler_label_line",
        "price_mode",
        "price_value",
        "price_low_expression",
        "price_low_source_line",
        "price_high_expression",
        "price_high_source_line",
        "price_compare_expression",
        "price_compare_source_line",
        "price_deduction_expression",
        "price_deduction_source_line",
        "rupee_balance_address_expression",
        "payment_call_source_line",
        "receipt_method",
        "receipt_item_index",
        "receipt_index_expression",
        "receipt_selector_source_line",
        "receipt_call_source_line",
        "source_item_annotation",
        "source_item_annotation_line",
        "reward_flag_address_expression",
        "reward_flag_value_expression",
        "reward_flag_source_line",
        "source_reward_comment",
        "tagalong_spawn_source_line",
        "source_revision"
      ],
      "properties": {
        "table_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "transaction_label": {
          "type": "string",
          "minLength": 1
        },
        "shop_type": {
          "enum": [
            "bomb-shop",
            "bottle-vendor"
          ]
        },
        "source_file": {
          "enum": [
            "sprite_bomb_shop_entity.asm",
            "sprite_bottle_vendor.asm"
          ]
        },
        "source_handler_label": {
          "type": "string",
          "minLength": 1
        },
        "source_handler_range_annotation": {
          "type": "string",
          "pattern": "^\\$[0-9A-Fa-f]+-\\$[0-9A-Fa-f]+(?: LOCAL)? JUMP LOCATION$"
        },
        "source_handler_label_line": {
          "type": "integer",
          "minimum": 1
        },
        "reward_handler_label": {
          "type": "string",
          "minLength": 1
        },
        "reward_handler_range_annotation": {
          "type": "string",
          "pattern": "^\\$[0-9A-Fa-f]+-\\$[0-9A-Fa-f]+(?: LOCAL)? JUMP LOCATION$"
        },
        "reward_handler_label_line": {
          "type": "integer",
          "minimum": 1
        },
        "price_mode": {
          "enum": [
            "shopkeeper-a-y-registers",
            "wallet-balance-compare-and-deduction"
          ]
        },
        "price_value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "price_low_expression": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[0-9A-Fa-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_low_source_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "price_high_expression": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[0-9A-Fa-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_high_source_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "price_compare_expression": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[0-9A-Fa-f]{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_compare_source_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "price_deduction_expression": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[0-9A-Fa-f]{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_deduction_source_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rupee_balance_address_expression": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "payment_call_source_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_method": {
          "enum": [
            "ShopItem_HandleReceipt",
            "special-bomb-flag-and-tagalong",
            "Link_ReceiveItem"
          ]
        },
        "receipt_item_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_index_expression": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[0-9A-Fa-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_selector_source_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_call_source_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_item_annotation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_item_annotation_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reward_flag_address_expression": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reward_flag_value_expression": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[0-9A-Fa-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reward_flag_source_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_reward_comment": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tagalong_spawn_source_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "source_only",
        "rom_bytes_read",
        "source_range_annotations_verified",
        "price_behavior_runtime_verified",
        "receipt_item_names_resolved",
        "room_specific_shop_stock_resolved",
        "canonical_item_ids_resolved",
        "special_bomb_reward_runtime_verified"
      ],
      "properties": {
        "source_only": {
          "const": true
        },
        "rom_bytes_read": {
          "const": false
        },
        "source_range_annotations_verified": {
          "const": false
        },
        "price_behavior_runtime_verified": {
          "const": false
        },
        "receipt_item_names_resolved": {
          "const": false
        },
        "room_specific_shop_stock_resolved": {
          "const": false
        },
        "canonical_item_ids_resolved": {
          "const": false
        },
        "special_bomb_reward_runtime_verified": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  }
}
