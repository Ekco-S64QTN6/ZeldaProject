{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zelda Suite ROM scalar-table verification report (v2)",
  "description": "Version 2 read-only comparison report for registered scalar data-table literals; optionally records unresolved expression shapes without evaluating assembler syntax.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "rom",
    "registry",
    "assets",
    "summary"
  ],
  "properties": {
    "format": {
      "const": "zelda-suite-rom-table-verification"
    },
    "format_version": {
      "const": 2
    },
    "rom": {
      "type": "object",
      "required": [
        "filename",
        "size_bytes",
        "sha256",
        "header_assessment",
        "provenance_verified"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "const": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "header_assessment": {
          "const": "headerless-by-expected-size"
        },
        "provenance_verified": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "registry": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "table_asset_count",
        "pass_asset_count",
        "partial_asset_count",
        "skipped_asset_count",
        "failed_asset_count",
        "checked_entries",
        "skipped_entries",
        "resolved_signed_decimal_entries",
        "mismatches",
        "unresolved_expression_count"
      ],
      "properties": {
        "table_asset_count": {
          "type": "integer",
          "minimum": 1
        },
        "pass_asset_count": {
          "type": "integer",
          "minimum": 0
        },
        "partial_asset_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_asset_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_asset_count": {
          "type": "integer",
          "minimum": 0
        },
        "checked_entries": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_entries": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_signed_decimal_entries": {
          "type": "integer",
          "minimum": 0
        },
        "mismatches": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_expression_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "name",
        "source_file",
        "source_revision",
        "table_label",
        "directive",
        "literal_width_bytes",
        "entry_stride_bytes",
        "entry_count",
        "checked_entries",
        "skipped_entries",
        "resolved_signed_decimal_entries",
        "mismatch_count",
        "status",
        "mismatches",
        "unresolved_expressions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "table_label": {
          "type": "string",
          "minLength": 1
        },
        "directive": {
          "enum": [
            "db",
            "dw",
            "dl"
          ]
        },
        "literal_width_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "entry_stride_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "checked_entries": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_entries": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_signed_decimal_entries": {
          "type": "integer",
          "minimum": 0
        },
        "mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "pass",
            "partial",
            "skip",
            "fail"
          ]
        },
        "mismatches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mismatch"
          }
        },
        "unresolved_expressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unresolved_expression"
          }
        }
      },
      "additionalProperties": false
    },
    "mismatch": {
      "type": "object",
      "required": [
        "table_index",
        "offset",
        "expression",
        "reason",
        "expected_hex",
        "actual_hex"
      ],
      "properties": {
        "table_index": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expected_hex": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9A-F]*$"
        },
        "actual_hex": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9A-F]*$"
        }
      },
      "additionalProperties": false
    },
    "unresolved_expression": {
      "type": "object",
      "required": [
        "table_index",
        "offset",
        "source_line",
        "expression",
        "classification",
        "reason"
      ],
      "properties": {
        "table_index": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "symbol",
            "symbol_with_numeric_addend",
            "compound_or_assembler_specific",
            "other"
          ]
        },
        "reason": {
          "const": "Expression is not a supported numeric literal; it was not evaluated."
        }
      },
      "additionalProperties": false
    }
  }
}
