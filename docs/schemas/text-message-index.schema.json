{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zelda Suite source text message index",
  "description": "Source-label and size metadata for encoded message streams; message bytes and decoded text are not included.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "source_revision",
    "source_block_count",
    "source_blocks",
    "message_count",
    "messages"
  ],
  "properties": {
    "format": {
      "const": "zelda-suite-text-message-index"
    },
    "format_version": {
      "const": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "source_block_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_block"
      }
    },
    "message_count": {
      "type": "integer",
      "minimum": 1
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_block": {
      "type": "object",
      "required": [
        "source_file",
        "data_block_label",
        "block_start_offset",
        "block_end_offset",
        "block_size_bytes",
        "message_count",
        "declared_byte_count_total",
        "declared_bytes_match_block_size"
      ],
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "data_block_label": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "block_start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "block_end_offset": {
          "type": "integer",
          "minimum": 0
        },
        "block_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "message_count": {
          "type": "integer",
          "minimum": 1
        },
        "declared_byte_count_total": {
          "type": "integer",
          "minimum": 1
        },
        "declared_bytes_match_block_size": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": [
        "message_index",
        "message_id",
        "message_label",
        "source_file",
        "data_block_label",
        "source_line",
        "source_offset_annotation",
        "annotated_file_offset",
        "source_offset_annotation_valid",
        "source_offset_matches_sequential",
        "sequential_file_offset",
        "declared_byte_count",
        "source_revision"
      ],
      "properties": {
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "message_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "message_label": {
          "type": "string",
          "pattern": "^Message_[0-9A-F]{4}$"
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "data_block_label": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "source_offset_annotation": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\$[0-9A-Fa-f]+$"
        },
        "annotated_file_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_offset_annotation_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_offset_matches_sequential": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sequential_file_offset": {
          "type": "integer",
          "minimum": 0
        },
        "declared_byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
