{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zelda Suite source music track pointer index",
  "description": "Metadata-only source inventory of music track pointer expressions; song payloads and SPC data are not included.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "source_file",
    "source_revision",
    "block_label",
    "base_expression",
    "table_file_offset",
    "table_end_offset",
    "table_size_bytes",
    "entry_width_bytes",
    "track_index_start",
    "track_index_end",
    "entry_count",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "zelda-suite-music-track-index"
    },
    "format_version": {
      "const": 1
    },
    "source_file": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "block_label": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "base_expression": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "table_file_offset": {
      "type": "integer",
      "minimum": 0
    },
    "table_end_offset": {
      "type": "integer",
      "minimum": 0
    },
    "table_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "entry_width_bytes": {
      "const": 2
    },
    "track_index_start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "track_index_end": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "table_index",
        "track_index",
        "pointer_entry_file_offset",
        "source_line",
        "pointer_expression",
        "target_label",
        "is_empty",
        "alias_of_track_index",
        "source_comment_index",
        "source_revision"
      ],
      "properties": {
        "table_index": {
          "type": "integer",
          "minimum": 0
        },
        "track_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "pointer_entry_file_offset": {
          "type": "integer",
          "minimum": 0
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "pointer_expression": {
          "type": "string",
          "pattern": "^(?:\\$[0-9A-Fa-f]{4}|[A-Za-z_][A-Za-z0-9_]*)$"
        },
        "target_label": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "is_empty": {
          "type": "boolean"
        },
        "alias_of_track_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535
        },
        "source_comment_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
